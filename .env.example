# Copy this file to .env and fill in your own values. Never commit .env.

# Telegram bot token from @BotFather (required, the only secret the bot needs)
BOT_TOKEN=your-telegram-bot-token

# Database URL. SQLite for local runs, PostgreSQL in production / Docker
DATABASE_URL=sqlite+aiosqlite:///./finance.db
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/finance

# Defaults for new users
DEFAULT_TIMEZONE=Asia/Qyzylorda
DEFAULT_CURRENCY=KZT

LOG_LEVEL=INFO
