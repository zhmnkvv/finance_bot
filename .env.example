# Токен Telegram-бота от @BotFather (обязательно)
BOT_TOKEN=123456:replace-me

# Ключ Claude API (необязательно: без него работает только rule-based разбор)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# База данных. Локально можно SQLite, в Docker — PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./planner.db
# DATABASE_URL=postgresql+asyncpg://planner:planner@localhost:5432/planner

# Часовой пояс по умолчанию для новых пользователей (IANA)
DEFAULT_TIMEZONE=Asia/Qyzylorda

LOG_LEVEL=INFO
