# Токен Telegram-бота от @BotFather — единственный обязательный секрет
BOT_TOKEN=123456:replace-me

# База данных. Локально — SQLite, в Docker — PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./finance.db
# DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5432/finance

# Значения по умолчанию для новых пользователей
DEFAULT_TIMEZONE=Asia/Qyzylorda
DEFAULT_CURRENCY=KZT

LOG_LEVEL=INFO
