# Скопируйте этот файл в .env и впишите свои значения. Никогда не коммитьте .env.

# Токен Telegram-бота от @BotFather (обязательно; единственный секрет, который нужен боту)
BOT_TOKEN=your-telegram-bot-token

# Адрес базы данных. SQLite для локального запуска, PostgreSQL для продакшена / Docker
DATABASE_URL=sqlite+aiosqlite:///./finance.db
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/finance

# Значения по умолчанию для новых пользователей
DEFAULT_TIMEZONE=Asia/Qyzylorda
DEFAULT_CURRENCY=KZT

LOG_LEVEL=INFO
